# GEMINI_API_KEY: Optional. For dynamic LLM reasoning via Google GenAI SDK.
# If omitted or mock, high-fidelity deterministic reasoning is used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# HINDSIGHT_URL: Vectorize Hindsight service endpoint (e.g. https://api.hindsight.vectorize.io)
HINDSIGHT_URL="https://api.hindsight.vectorize.io"

# HINDSIGHT_API_KEY: API key for Vectorize Hindsight episodic memory layer.
# When provided, memories are synced to live Vectorize storage.
# When omitted, the built-in resilient in-process memory engine is utilized.
HINDSIGHT_API_KEY="MY_HINDSIGHT_API_KEY"

# APP_URL: Host URL for self-referential links
APP_URL="http://localhost:3000"

# GOOGLE MAPS API KEY (Client-side)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"
